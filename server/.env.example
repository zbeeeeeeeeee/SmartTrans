# 服务端口
PORT=28123

# JWT 密钥 (生产环境请更换为随机字符串)
JWT_SECRET=smarttrans-dev-secret-change-in-production

# 视觉模型（图像识别）
QWEN_API_KEY=sk-xxxx
QWEN_BASE_URL=https://api.siliconflow.cn/v1
QWEN_VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct

# 推理模型（严重度/责任/报告）
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.siliconflow.cn/v1
DEEPSEEK_MODEL=Qwen/Qwen3.5-397B-A17B

# 嵌入模型（RAG）
EMBEDDING_API_KEY=sk-xxxx
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# 嵌入向量维度，必须与嵌入模型输出维度一致（Qwen3-Embedding-8B 为 4096）
EMBEDDING_DIM=4096

# 是否启用MCP工具
MCP_ENABLED=false

# 强制启用日志颜色（当通过 concurrently/PM2 等工具启动时，stdout 可能不是 TTY）
FORCE_COLOR=1