\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{g+gh}{\PYGZsh{} Severity Assessment Checklist}

\PYG{g+gu}{\PYGZsh{}\PYGZsh{} Instructions}

When assessing accident severity, systematically evaluate:

\PYG{g+gu}{\PYGZsh{}\PYGZsh{}\PYGZsh{} 1. Vehicle Damage}
\PYG{k}{\PYGZhy{}}\PYG{+w}{ }Level A: Cosmetic damage only (scratches, dents)
\PYG{k}{\PYGZhy{}}\PYG{+w}{ }Level B: Functional damage (lights, mirrors, windows)
\PYG{k}{\PYGZhy{}}\PYG{+w}{ }Level C: Structural damage (frame, axles, crumple zones)
\PYG{k}{\PYGZhy{}}\PYG{+w}{ }Level D: Total loss

\PYG{g+gu}{\PYGZsh{}\PYGZsh{}\PYGZsh{} 2. Injury Classification}
\PYG{k}{\PYGZhy{}}\PYG{+w}{ }Minor: Bruises, whiplash — outpatient treatment
\PYG{k}{\PYGZhy{}}\PYG{+w}{ }Moderate: Fractures, lacerations — hospitalization \PYGZlt{} 7 days
\PYG{k}{\PYGZhy{}}\PYG{+w}{ }Severe: Life\PYGZhy{}threatening, permanent disability — hospitalization ≥ 7 days
\PYG{k}{\PYGZhy{}}\PYG{+w}{ }Fatal: One or more fatalities

\PYG{g+gu}{\PYGZsh{}\PYGZsh{}\PYGZsh{} 3. Environmental Hazards}
\PYG{k}{\PYGZhy{}}\PYG{+w}{ }Fluid spills (fuel, oil, coolant)
\PYG{k}{\PYGZhy{}}\PYG{+w}{ }Road blockage (partial or full lane closure)
\PYG{k}{\PYGZhy{}}\PYG{+w}{ }Secondary collision risk (blind curves, high\PYGZhy{}speed traffic)
\end{MintedVerbatim}
